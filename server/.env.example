# ── Shyastha API · copy to server/.env for local development ──
# On Render, set these under the service's Environment tab instead (never commit real values).

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shyastha?retryWrites=true&w=majority

# Long random secret used to sign sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The website's address(es), comma-separated. Must match exactly (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Proxies in front of the server: 1 locally/Render, 2 when called through the Netlify /api proxy.
TRUST_PROXY=1

# First Super Admin. Only used when the database has no accounts yet; remove afterwards.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Cloudinary (optional, recommended): uploads go to Cloudinary and are delivered from its CDN.
# Cloudinary → Settings → API Keys → copy the "API environment variable". Leave empty to store
# uploads in the database instead.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=shyastha

# Optional
# PORT=4000
# SESSION_HOURS=12
# IMAGE_MAX_MB=5
# VIDEO_MAX_MB=60
