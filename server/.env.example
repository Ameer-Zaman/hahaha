# ── Shyastha API · copy to server/.env for local development ──
# On Render, set these under the service's Environment tab instead (never commit real values).

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Include the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shyastha?retryWrites=true&w=majority

# Long random secret used to sign sessions (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The website's address(es), comma-separated. Must match exactly (no trailing slash).
CLIENT_ORIGIN=http://localhost:5173

# Proxies in front of the server: 1 locally and on Render (the Cloudflare Worker passes the
# visitor's real address on, so Render is the only hop the server itself sees). Set it wrong
# and every visitor looks like one address, which makes the sign-in rate limit lock everyone
# out at once. After deploying, check the audit log: failed sign-ins should show the real
# addresses, not the same one every time.
TRUST_PROXY=1

# Shown in an authenticator app next to the six digits, so staff know which entry is which.
# SITE_NAME=Rameirah Empire

# Sign-in attempts allowed per address, and per account, every 15 minutes.
# LOGIN_ATTEMPTS_PER_15_MIN=10

# How large a backup file may be when it is put back. Only the restore request uses this;
# everything else the panel sends is capped at 1 MB.
# BACKUP_MAX_MB=25mb

# Ceiling on how fast one address may call the API at all (per minute). The website's
# visitors are served from Cloudflare's cache and rarely reach here; this is what stops a
# script pointed straight at the API address. Sign-in and chat have their own tighter limits.
# RATE_LIMIT_PER_MINUTE=300

# First Super Admin. Only used when the database has no accounts yet; remove afterwards.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin

# Cloudinary (optional, recommended): uploads go to Cloudinary and are delivered from its CDN.
# Cloudinary → Settings → API Keys → copy the "API environment variable". Leave empty to store
# uploads in the database instead.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_FOLDER=shyastha

# Rules help chat → Discord (optional): "Ask staff" opens a thread in this channel.
# DISCORD_BOT_TOKEN=
# DISCORD_CHAT_CHANNEL_ID=
# DISCORD_STAFF_ROLE_ID=        (optional: this role is pinged on each new question)
# PUBLIC_DISCORD_INVITE=https://discord.gg/Dtd3DSej6
# For local testing without Discord: DISCORD_BOT_TOKEN=fake (refused in production)

# Optional
# PORT=4000
# SESSION_HOURS=12
# IMAGE_MAX_MB=5
# VIDEO_MAX_MB=60
