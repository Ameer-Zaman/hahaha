# ── Website settings (copy to client/.env.local for local development) ──

# Set to "false" to build a fully static site that never calls the API
# (pages then use the built-in content in src/content/).
VITE_USE_API=true

# Optional: the API server's own address, used only to send big uploads (videos) straight to
# it, because the Netlify /api proxy stops after 26 seconds. Example:
#   VITE_API_DIRECT_URL=https://shyastha-api.onrender.com
# Leave empty to upload through /api like everything else.
VITE_API_DIRECT_URL=

# Local development only: where the /api proxy points (default http://localhost:4000).
# API_PROXY_TARGET=http://localhost:4000
